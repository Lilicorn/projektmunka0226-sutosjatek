<Page x:Class="ALegjobbSutosJatekProjekt.OutroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ALegjobbSutosJatekProjekt"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OutroPage">

    <Grid Background="#FFFFDAFC">
        <Image Source="/otherassets/background1.png" Stretch="UniformToFill" OpacityMask="#B2C1C1C1"></Image>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>

                <Image>

                </Image>

            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Source="\otherassets\intrologo.png" Stretch="Uniform"/>
                <Button x:Name="play" Grid.Row="1" Click="Play_Click" Style="{StaticResource GameButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/replaybutton.PNG" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
                <Button x:Name="more" Grid.Row="2" Margin="20pt 10pt" Content="MORE"  Click="more_Click" Style="{StaticResource GameButtonStyle}" FontSize="20pt" FontFamily="Gill Sans Ultra Bold" Foreground="White">
                    <Button.Background>
                        <ImageBrush ImageSource="/otherassets/morebutton.PNG" Stretch="Uniform"/>
                    </Button.Background>
                </Button>

            </Grid>
        </Grid>

    </Grid>
</Page>
