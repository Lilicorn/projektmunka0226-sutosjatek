<Page x:Class="ALegjobbSutosJatekProjekt.OutroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ALegjobbSutosJatekProjekt"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="OutroPage">

    <Grid Background="#FFFFDAFC">
        <Image Source="/otherassets/background1.png" Stretch="UniformToFill" OpacityMask="#B2C1C1C1"></Image>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">

                <Image x:Name="topside_frame1" Grid.Column="2" Panel.ZIndex="7" Margin="15pt" Source="/decorassets/topside/topside_11.png" Stretch="Uniform"/>
                <Image x:Name="top_frame" Grid.Column="2" Panel.ZIndex="6" Margin="15pt" Source="/decorassets/top/top_1.png" Stretch="Uniform"/>
                <Image x:Name="midside_frame" Grid.Column="2" Panel.ZIndex="4" Margin="15pt" Source="/decorassets/midside/midside_1.png" Stretch="Uniform"/>
                <Image x:Name="bottomside_frame" Grid.Column="2" Panel.ZIndex="3" Margin="15pt" Source="/decorassets/bottomside/bottomside_1.png" Stretch="Uniform"/>
                <Image x:Name="topfrosting_frame" Grid.Column="2" Panel.ZIndex="3" Margin="15pt" Source="decorassets/topfrosting/topfrosting_1.png" Stretch="Uniform"/>
                <Image x:Name="coveringcolor_frame" Grid.Column="2" Panel.ZIndex="2" Margin="15pt" Source="/decorassets/coveringcolor/coveringcolor_1.png" Stretch="Uniform"/>
                <Image x:Name="basecake" Grid.Column="2" Panel.ZIndex="1" Margin="15pt" Source="decorassets/basecake.PNG" Stretch="Uniform"/>
                <Image x:Name="stand_frame" Grid.Column="2" Panel.ZIndex="0" Margin="15pt" Source="/decorassets/stand/stand_1.png" Stretch="Uniform"/>

            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Source="\otherassets\intrologo.png" Stretch="Uniform"/>
                <Button x:Name="replay" Grid.Row="1" Click="Play_Click" Style="{StaticResource GameButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/otherassets/replaybutton.PNG" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
                <Button x:Name="more" Grid.Row="2" Margin="20pt 10pt" Content="MORE"  Click="more_Click" Style="{StaticResource GameButtonStyle}" FontSize="20pt" FontFamily="Comic Sans MS" Foreground="White">
                    <Button.Background>
                        <ImageBrush ImageSource="/otherassets/morebutton.PNG" Stretch="Uniform"/>
                    </Button.Background>
                </Button>

            </Grid>
        </Grid>

    </Grid>
</Page>
