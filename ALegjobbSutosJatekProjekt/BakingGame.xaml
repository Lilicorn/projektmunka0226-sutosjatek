<Page x:Class="ALegjobbSutosJatekProjekt.BakingGame"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ALegjobbSutosJatekProjekt"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="BakingGame">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>


        <Label FontSize="30" Panel.ZIndex="1" x:Name="Instructions" Content="placeholder" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>

        <Grid Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1" x:Name="ingredientsection" Background="Transparent" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" x:Name="ingredient0" Margin="15pt" Tag="" Source="/assets/ingplaceholder.JPG" MouseLeftButtonDown="MouseDown" MouseMove="MouseMove" MouseUp="MouseUp" />
                        <Image Grid.Column="1" x:Name="ingredient2" Margin="15pt" Tag="" Source="/assets/ingplaceholder.JPG" MouseLeftButtonDown="MouseDown" MouseMove="MouseMove" MouseUp="MouseUp"/>
                        <Image Grid.Column="2" x:Name="ingredient4" Margin="15pt" Tag="" Source="/assets/ingplaceholder.JPG" MouseLeftButtonDown="MouseDown" MouseMove="MouseMove" MouseUp="MouseUp"/>

                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                            <ColumnDefinition Width="2*"></ColumnDefinition>
                            <ColumnDefinition Width="2*"></ColumnDefinition>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="1" x:Name="ingredient1" Margin="15pt" Tag="" Source="/assets/ingplaceholder.JPG" MouseLeftButtonDown="MouseDown"/>
                        <Image Grid.Column="2" x:Name="ingredient3" Margin="15pt" Tag="" Source="/assets/ingplaceholder.JPG" MouseLeftButtonDown="MouseDown"/>

                    </Grid>
                </Grid>
                <Image Source="/targetassets/1_0.png" Margin="15pt" Grid.Column="2" x:Name="Usualtarget" Tag=""/>

            </Grid>

            <Image  Panel.ZIndex="-1" Source="/background2.png" Stretch="Fill"  />

        </Grid>

        <Image Source="/background1.png" Stretch="UniformToFill"></Image>
        <Canvas Panel.ZIndex="0" x:Name="background" Background="Transparent"/>


    </Grid>
</Page>
