<Page x:Class="ALegjobbSutosJatekProjekt.DecoratingGame"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ALegjobbSutosJatekProjekt"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DecoratingGame" SizeChanged="Page_SizeChanged">

    <Grid>
        <Grid Margin="15pt">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="7*"></ColumnDefinition>
                <ColumnDefinition Width="7*"></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <Button  Click="Loader_Click" x:Name="top_loader" Margin="0 3pt" Height="30pt" FontFamily="Comic Sans MS" FontSize="20" Content="1" Foreground="White" BorderBrush="White" Style="{StaticResource GameButtonStyle}" >
                    <Button.Background>
                        <ImageBrush ImageSource="/squarebutton.png"/>
                    </Button.Background>
                </Button>
                <Button  Click="Loader_Click" x:Name="topside_loader" Margin="0 3pt" Height="30pt" FontFamily="Comic Sans MS" FontSize="20" Content="2" Foreground="White" BorderBrush="White" Style="{StaticResource GameButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/otherassets/squarebutton.png"/>
                    </Button.Background>
                </Button>
                <Button  Click="Loader_Click" x:Name="midside_loader" Margin="0 3pt" Height="30pt" FontFamily="Comic Sans MS" FontSize="20" Content="3" Foreground="White" BorderBrush="White" Style="{StaticResource GameButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/otherassets/squarebutton.png"/>
                    </Button.Background>
                </Button>
                <Button  Click="Loader_Click" x:Name="bottomside_loader" Margin="0 3pt" Height="30pt" FontFamily="Comic Sans MS" FontSize="20" Content="4" Foreground="White" BorderBrush="White" Style="{StaticResource GameButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/otherassets/squarebutton.png"/>
                    </Button.Background>
                </Button>
                <Button  Click="Loader_Click" x:Name="topfrosting_loader" Margin="0 3pt" Height="30pt" FontFamily="Comic Sans MS" FontSize="20" Content="5" Foreground="White" BorderBrush="White" Style="{StaticResource GameButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/otherassets/squarebutton.png"/>
                    </Button.Background>
                </Button>
                <Button  Click="Loader_Click" x:Name="coveringcolor_loader" Margin="0 3pt" Height="30pt" FontFamily="Comic Sans MS" FontSize="20" Content="6" Foreground="White" BorderBrush="White" Style="{StaticResource GameButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/otherassets/squarebutton.png"/>
                    </Button.Background>
                </Button>
                <Button  Click="Loader_Click" x:Name="stand_loader" Margin="0 3pt" Height="30pt" FontFamily="Comic Sans MS" FontSize="20" Content="7" Foreground="White" BorderBrush="White" Style="{StaticResource GameButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/otherassets/squarebutton.png"/>
                    </Button.Background>
                </Button>
            </StackPanel>

            <ListBox x:Name="decorListing" SelectionChanged="decorListing_SelectionChanged"  Margin="5pt 0 0 0" Grid.Column="1" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="{x:Null}" ItemContainerStyle="{StaticResource ListBoxHoverer}">
                <ListBox.Background>
                    <ImageBrush ImageSource="/lbbg.png"/>
                </ListBox.Background>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5">
                            <Image Source="{Binding}"
                       Width="100"
                       Height="100"
                       Stretch="Uniform"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
            
            <Image x:Name="topside_frame1" Grid.Column="2" Panel.ZIndex="7" Margin="15pt" Source="/decorassets/topside/topside_11.png" Stretch="Uniform"/>
            <Image x:Name="top_frame" Grid.Column="2" Panel.ZIndex="6" Margin="15pt" Source="/decorassets/top/top_1.png" Stretch="Uniform"/>
            <Image x:Name="midside_frame" Grid.Column="2" Panel.ZIndex="4" Margin="15pt" Source="/decorassets/midside/midside_1.png" Stretch="Uniform"/>
            <Image x:Name="bottomside_frame" Grid.Column="2" Panel.ZIndex="3" Margin="15pt" Source="/decorassets/bottomside/bottomside_1.png" Stretch="Uniform"/>
            <Image x:Name="topfrosting_frame" Grid.Column="2" Panel.ZIndex="3" Margin="15pt" Source="decorassets/topfrosting/topfrosting_1.png" Stretch="Uniform"/>
            <Image x:Name="coveringcolor_frame" Grid.Column="2" Panel.ZIndex="2" Margin="15pt" Source="/decorassets/coveringcolor/coveringcolor_1.png" Stretch="Uniform"/>

            <Image x:Name="basecake" Grid.Column="2" Panel.ZIndex="1" Margin="15pt" Source="/basecake.PNG" Stretch="Uniform"/>

            <Image x:Name="stand_frame" Grid.Column="2" Panel.ZIndex="0" Margin="15pt" Source="/decorassets/stand/stand_1.png" Stretch="Uniform"/>

            <Button Height="30pt" Grid.Column="3" VerticalAlignment="Bottom" Click="Outro_Click" x:Name="outro"  FontFamily="Comic Sans MS" FontSize="15" Content="Finish" Foreground="White" BorderBrush="{x:Null}" Style="{StaticResource GameButtonStyle}">
                <Button.Background>
                    <ImageBrush ImageSource="/otherassets/morebutton.PNG"/>
                </Button.Background>
            </Button>

        </Grid>

        <Image x:Name="table" Margin="0 115pt 0 0" Panel.ZIndex="-1" Source="/otherassets/background2.jpg" Stretch="Fill"  />

        <Image Panel.ZIndex="-2" Source="/otherassets/background1.png" Stretch="UniformToFill"></Image>
    </Grid>
</Page>
